# iOS Podfile for React Native YouTube M4A to MP3 Converter
platform :ios, '14.0'
use_frameworks! :linkage => :static

target 'YouTubeM4aToMp3Converter' do
  config = use_native_modules!

  # Enable FFmpegKit Full Audio Package for iOS
  pod 'ffmpeg-kit-react-native-full', '6.0'

  # Pods for Expo audio and file system modules
  pod 'ExpoAudio', :path => '../node_modules/expo-av'
  pod 'ExpoFileSystem', :path => '../node_modules/expo-file-system'
  pod 'ExpoSharing', :path => '../node_modules/expo-sharing'

  post_install do |installer|
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      end
    end
  end
end
